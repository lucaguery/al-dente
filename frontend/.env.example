# Backend Railway URL — used by next.config.ts rewrites only.
# Server-side env var (NOT NEXT_PUBLIC_) so it never ships in the browser bundle.
# Production (Vercel): set to https://<project>.up.railway.app or custom domain.
# Local dev: set to http://localhost:8000 in .env.local.
RAILWAY_URL=https://your-railway-url.up.railway.app

# These become "" in production (rewrites make /api/* same-origin).
# Keep empty in production; can point at localhost for direct-to-backend dev.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_BASE=
