.env
.agents
.vercel
.planning/.next-call-count

# Phase 10 — test env files (T-10-02 / T-10-03 mitigation)
.env.test
.env.test.local
!.env.test.example

# Playwright MCP browser session output — screenshots, console logs,
# DOM snapshots saved during interactive `mcp__playwright__*` runs.
# Per-spec test artifacts (test-results/, playwright-report/) live under
# frontend/ and are already gitignored there.
.playwright-mcp/

# Diagnostic Playwright MCP screenshots saved to repo root.
# When intentionally capturing a screenshot, write to .playwright-mcp/
# instead so this pattern doesn't need to widen.
/*.playwright-screenshot.png
.scratch/

# Coverage artifacts (generated by pytest --cov-report=json).
backend/coverage.json
backend/htmlcov/

# Python bytecode in scripts/ (generated when script is imported in tests).
scripts/__pycache__/

# Graphify knowledge graph artifacts.
# Rebuilt locally by the post-commit hook (`graphify hook install`).
# `.planning/graphs/` is the GSD-wrapper destination; `graphify-out/` is the
# upstream tool's own working directory.
graphify-out/
.planning/graphs/